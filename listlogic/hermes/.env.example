# ListLogic Hermes — Railway service env (never commit real values)
# Separate bot + service from SAA Homes Hermes.

HERMES_HOME=/opt/data

# REQUIRED to start growth loops
OPENCODE_GO_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

API_SERVER_KEY=generate-a-long-random-string
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_CORS_ORIGINS=*

HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=choose-a-strong-password
HERMES_DASHBOARD_BASIC_AUTH_SECRET=generate-with-openssl-rand-base64-32

OUTREACH_APPROVAL_REQUIRED=true
AUTO_MERGE_SEO_PRS=true

LISTLOGIC_SITE_URL=https://listlogic.homes

# Analytics (listlogic.homes property — not SAA)
# GA4_MEASUREMENT_ID=G-XXXXXXXX
# GA4_PROPERTY_ID=
# GSC_SERVICE_ACCOUNT_JSON_B64=

# SERPAPI_API_KEY=

# GitHub — PRs under listlogic/ in monorepo
# GITHUB_TOKEN=
# GITHUB_REPO=adamsch0100/saahomes

# Redeploy ListLogic WEBSITE service after merge — never Hermes service ID
# RAILWAY_TOKEN=
# RAILWAY_SERVICE_ID=

# Optional Browserbase — competitor/MLS research only
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=

# Outreach draft packs email to Adam
# OUTREACH_SMTP_HOST=smtp.gmail.com
# OUTREACH_SMTP_USER=adam@saahomes.com
# OUTREACH_SMTP_PASSWORD=
# OUTREACH_EMAIL_TO=adam@saahomes.com
