# ListLogic — copy to .env for local; set the same on Railway.

# Primary public URL (emails + invite links)
APP_BASE_URL=https://listlogic.homes

# Session signing
SESSION_SECRET=change-me-to-a-long-random-string

# Bootstrap admin (created on first boot if missing)
ADMIN_BOOTSTRAP_EMAIL=adam@saahomes.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-before-prod

# Trial defaults — public signup is setup-only (0 free custom presentations).
# Promo/invite codes can still grant complimentary credits.
DEFAULT_TRIAL_DAYS=0
DEFAULT_PRESENTATION_LIMIT=0
# Stripe Checkout: agent_monthly gets this many trial days (card required).
STRIPE_TRIAL_DAYS=7

# Stripe (Checkout + webhooks)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Optional overrides (defaults exist in stripe_billing.py):
# STRIPE_PRICE_AGENT_MONTHLY=
# STRIPE_PRICE_AGENT_ANNUAL=
# STRIPE_PRICE_ONE_TIME=
# STRIPE_PRICE_BROKERAGE_MONTHLY=
# STRIPE_PRICE_BROKERAGE_ANNUAL=

# Feedback inbox
FEEDBACK_TO=adam@saahomes.com

# Postgres on Railway (omit locally to use SQLite at output/listlogic.db)
# DATABASE_URL=postgresql://...

# SMTP (welcome, trial, feedback). Gmail app password works:
# GMAIL_USER=adam@saahomes.com
# GMAIL_APP_PASSWORD=
# Or:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Optional cron auth for POST /api/internal/trial-reminders
# CRON_SECRET=

# Legacy — retired for login (promo codes are in the DB now)
# BETA_ACCESS_TOKEN=
# ACCESS_CODES=

# Assistant (help bot) — OpenCode Go; flash is fine for grounded Q&A
# OPENCODE_GO_API_KEY=
# LISTLOGIC_ASSISTANT_MODEL=deepseek-v4-flash
# LISTLOGIC_LLM_MODEL=deepseek-v4-flash

# Zillow listing photos (ReefAPI)
# REEF_API_KEY=

# Mapbox GL (report maps + Generate market draw) — public pk.* token
# MAPBOX_ACCESS_TOKEN=pk.eyJ...

# GA4 (client) — Measurement ID from GA4 Admin → Data streams
# GA4_MEASUREMENT_ID=G-XXXXXXXX

