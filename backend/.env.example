# Database
DATABASE_URL=postgresql://user:password@localhost:5432/saahomes
# Schema migrations run at boot as named steps and record each finished one in
# schema_migrations. A step that fails is logged, skipped and listed by
# /api/notify-health (migrations.failed); the app keeps serving. Set
# MIGRATIONS_STRICT=1 to have a failed step stop the boot instead.
# MIGRATIONS_STRICT=1

# Server
PORT=3000
NODE_ENV=development

# Email (Gmail SMTP)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production

# Follow Up Boss Integration
FOLLOW_UP_BOSS_API_KEY=your-api-key
FOLLOW_UP_BOSS_WEBHOOK_URL=https://api.followupboss.com/v1/events

# GA4 Measurement Protocol (server-side lead events — optional but recommended)
# Create secret: GA4 Admin → Data streams → saahomes.com → Measurement Protocol API secrets
GA4_MEASUREMENT_ID=G-BVWCZE025P
GA4_MEASUREMENT_API_SECRET=

# AI Chat (OpenCode Go — same provider as Hermes Agent)
# Set the same API key from Hermes .env to enable the AI chat widget
OPENCODE_GO_API_KEY=

# Admin Credentials (will be hashed in production)
ADMIN_EMAIL=adam@saahomes.com
ADMIN_PASSWORD=your-admin-password


# Brokerage billing (Stripe). The secret key is all it needs: plan prices and the
# webhook are created on startup (see the platform console, Plans and billing).
# The webhook goes to SITE_URL (or Railway's own domain); set STRIPE_WEBHOOK_SECRET
# only to use an endpoint you made yourself. STRIPE_PRICE_BROKERAGE_SEAT is the
# older single per-agent price, used only if the plan prices can't be.
STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_BROKERAGE_SEAT=
# Encrypts credentials the app stores (64 hex characters); defaults to one derived from JWT_SECRET.
# CREDENTIALS_KEY=
